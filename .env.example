# ─── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier       # e.g. abc12345.us-east-1
SNOWFLAKE_USER=marketsignal_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=marketsignal_role
SNOWFLAKE_WAREHOUSE=compute_wh
SNOWFLAKE_DATABASE=marketsignal
SNOWFLAKE_SCHEMA=raw

# ─── MinIO (local S3-compatible storage) ──────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marketsignal-raw

# ─── SEC EDGAR ────────────────────────────────────────────────────────────────
# No API key required; set a descriptive User-Agent per EDGAR fair-use policy
EDGAR_USER_AGENT=MarketSignal/1.0 your_email@example.com

# ─── Groq (free LLM API) ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key                  # https://console.groq.com
GROQ_MODEL=llama3-8b-8192

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=./rag/chroma_store

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
